{
  "name": "@fastijs/scheduler",
  "version": "0.4.0",
  "description": "A type-safe, stateless scheduling engine for TypeScript.",
  "keywords": [
    "appointments",
    "bookings",
    "calendar",
    "scheduling",
    "temporal",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duarteplesteves/fasti.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "default": "./dist/adapter/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg/index.d.ts",
      "default": "./dist/drizzle/pg/index.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite/index.d.ts",
      "default": "./dist/drizzle/sqlite/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "default": "./dist/effect/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --project unit",
    "test:ci": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "prepare": "husky",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only",
    "test:integration": "vitest run --project conformance",
    "release": "bun run build && changeset publish"
  },
  "dependencies": {
    "effect": "^4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@fast-check/vitest": "^0.5.0",
    "@libsql/client": "^0.18",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "typescript": "^7.1.0-beta",
    "ultracite": "8.2.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.5 <2",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
