{
  "name": "better-schedule",
  "version": "0.1.0",
  "description": "A type-safe, stateless scheduling engine for TypeScript.",
  "keywords": [
    "appointments",
    "bookings",
    "calendar",
    "scheduling",
    "temporal",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duarteesteves/better-schedule.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsgo",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "prepare": "husky",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^25.8.0",
    "@typescript/native-preview": "^7.0.0-dev.20260515.1",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.13"
}
