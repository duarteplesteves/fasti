{
  "name": "@fastijs/scheduler",
  "version": "0.8.2",
  "description": "A type-safe scheduling framework for TypeScript that runs on your own database.",
  "keywords": [
    "appointments",
    "bookings",
    "calendar",
    "scheduling",
    "temporal",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duarteplesteves/fasti.git"
  },
  "files": [
    "dist",
    "docs/adr",
    "docs/guides",
    "examples/basic/*.ts",
    "examples/basic/README.md",
    "skills",
    "CHANGELOG.md",
    "GLOSSARY.md",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "default": "./dist/adapter/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg/index.d.ts",
      "default": "./dist/drizzle/pg/index.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite/index.d.ts",
      "default": "./dist/drizzle/sqlite/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "default": "./dist/effect/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "default": "./dist/prisma/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --project unit",
    "test:ci": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "bench": "nub run build && vitest bench --project \"bench (bench)\" --run --reporter=default",
    "clean": "rm -rf dist",
    "prepublishOnly": "nub run clean && nub run build",
    "prepare": "husky && effect-tsgo patch --oxlint",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc && tsc -p bench && tsc -p scripts",
    "typecheck:budget": "node bench/types/check-budget.ts",
    "publint": "publint",
    "check:links": "node scripts/check-pack-links.ts",
    "attw": "attw --pack --profile esm-only",
    "test:integration": "vitest run --project conformance",
    "release": "nub run build && changeset publish"
  },
  "dependencies": {
    "effect": "^4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "^0.73.4",
    "@fast-check/vitest": "^0.5.0",
    "@libsql/client": "^0.18",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "typescript": "^7.1.0-beta",
    "ultracite": "8.2.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@prisma/orm-postgres": ">=8.0.0-rc.24 <9",
    "drizzle-orm": ">=1.0.0-rc.5 <2",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@prisma/orm-postgres": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "ultracite fix --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.11.1",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
