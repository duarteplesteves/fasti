{
  "name": "@fastijs/scheduler",
  "version": "0.1.0-next.1",
  "description": "A type-safe, stateless scheduling engine for TypeScript.",
  "keywords": [
    "appointments",
    "bookings",
    "calendar",
    "scheduling",
    "temporal",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duarteplesteves/fasti.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "prepare": "husky",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "typescript": "^7.1.0-beta",
    "ultracite": "^8.1.1",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
